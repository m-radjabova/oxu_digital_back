# Local: copy this file to .env. Render: set values in Environment.
NODE_ENV=development
PORT=5050
# Required: MongoDB Atlas URI (replica set required for transactions).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/oxu_digital?retryWrites=true&w=majority
# Alternative to MONGODB_URI; leave blank when MONGODB_URI is configured.
DATABASE_URL=
# Required: generate a random secret, do not use this placeholder.
JWT_SECRET=replace-with-a-long-random-secret
# Frontend origins only, comma-separated, no trailing slash or paths.
FRONTEND_URL=http://localhost:5173
# Render reverse proxy; use 0 locally, 1 on Render.
TRUST_PROXY=0
# Optional: leave both blank to disable the Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_APP_URL=
# Initial administrator is created only when email and password are set.
ADMIN_NAME=OXU administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local/demo seed only; never run seed/reset against production.
SEED_PASSWORD=
